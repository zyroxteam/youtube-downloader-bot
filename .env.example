# Zyrox YouTube Downloader Bot — env vars template
# Copy to .env / set in your hosting platform. NEVER commit real secrets.

API_ID=12345678
API_HASH=your_api_hash_from_my_telegram_org
BOT_TOKEN=123456:your_bot_token_from_botfather
OWNER_ID=123456789

# Force Join (default channels: @ZyroxV1 + @ZyroxMod)
FORCE_JOIN=on
FORCE_JOIN_CHANNELS=ZyroxV1,ZyroxMod

# Health-check port (hosting platforms set this automatically)
PORT=8000
